[resource]
script = ExtResource("1_h5b5k")
id = "frost_bat"
title = "Frost Bat"
storyRequirements = Array[ExtResource("2_6xbjy")]([SubResource("Resource_gd3wc")])
description = "The Frost Bat is a rare sight, due to its preference for living in cold caves. If you see one out in the wild, it hasn't been able to find an enclosed space cold enough to be its habitat! It is afraid of Fire, but enjoys gliding the freezing Winds of the tundra at night."
