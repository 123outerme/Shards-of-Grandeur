storyRequirements = Array[ExtResource("2_8j8xr")]([SubResource("Resource_ia5gt")])
description = "A Fireclaw is a flaming hand-like entity.  The first Fireclaw was a magical conjuration that outlived its master and went rogue. Now, these beings wander torched landscapes, searching for something. They avoid Water at all costs, though."
