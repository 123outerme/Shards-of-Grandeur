[sub_resource type="Resource" id="Resource_nurtq"]
script = ExtResource("1_v1f10")
lines = Array[String](["Well done. I can see you're a strong self-taught warrior. Under my tutelage, you can refine your skills...", "Your first task will be to travel to the Iceberg Palace just outside our town's limits. It will be a test of your intuition and your tenacity.", "There, you will need to recover the $highlight{Moon Sigil}color$, one of the Warlock's three most treasured Astral artifacts. It is guarded well."])
